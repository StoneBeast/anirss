{
  "name": "anirss",
  "version": "1.13.4",
  "private": true,
  "description": "AniRSS · 追番台 — self-hosted RSS anime tracker that filters titles with regex and pushes them to qBittorrent",
  "main": "app/server/index.js",
  "scripts": {
    "start": "node app/server/index.js",
    "test": "node dev/unit.js && node dev/smoke.js && node dev/perf-check.js",
    "lint": "eslint . && stylelint \"app/www/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"app/www/**/*.css\" --fix"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
