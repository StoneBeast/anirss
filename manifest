appname               = anirss
version               = 1.7.0
display_name          = AniRSS 追番台
desc                  = 连接 qBittorrent，按「站点基础地址 + 路径」管理 RSS 追番与补番：站点搜索选发布组、集数识别、存储路径模板与变量、包含/排除正则、自动检查与下载记录。
platform              = all
source                = thirdparty
maintainer            = StoneBeast
maintainer_url        = https://github.com/StoneBeast/anirss
os_min_version        = 1.1.3100
desktop_uidir         = ui
desktop_applaunchname = anirss.main
service_port          = 18181
checkport             = false
ctl_stop              = true
disable_authorization_path = true
install_dep_apps      = nodejs_v24
changelog             = 1.7.0 项目更名 AniRSS（应用 id qbrss → anirss，环境变量 ANIRSS_*，首次启动自动迁移旧数据目录）；新增配置导入；保留 ${name} 路径变量与集数识别等全部功能。1.6.4 修复清空已见后无法重新下载，新增重新下载/允许重下。1.6.3 封面视图操作收进右上角悬浮区并支持删除。1.6.2 路径模板变量里的 ${name} 会替换。1.6.1 发布组真实集数、集数识别。1.6.0 “订阅”更名“追番”、补番、站点搜索。1.5.0 名称自动获取、${name} 变量、封面视图。1.4.0 网络代理、封面/番组信息。1.3.x 修复复选框/补下现有。1.2.x 修复 qB 上传。1.1.0 浅色主题、独立端口、路径模板。1.0.0 首个版本。
