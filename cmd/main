#!/bin/bash
# anirss 生命周期：start | stop | status
#
# 服务通过 Unix Socket（$TRIM_APPDEST/app.sock）暴露 HTTP，
# 由 fnOS 统一网关 /app/anirss 反向代理，复用 NAS 登录态。

set -u

APP="${TRIM_APPDEST:-/var/apps/anirss/target}"
VAR="${TRIM_PKGVAR:-/var/apps/anirss/var}"
SOCK="$APP/app.sock"
PIDF="$VAR/app.pid"
LOG="$VAR/app.log"
SERVER="$APP/server/index.js"

export PATH=/var/apps/nodejs_v24/target/bin:$PATH
export ANIRSS_PORT="${ANIRSS_PORT:-${QBRSS_PORT:-${TRIM_SERVICE_PORT:-18181}}}"
umask 027

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"$LOG" 2>/dev/null; }

fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        {
            echo "$1"
            echo ""
            echo "--- 最近日志（$LOG）---"
            tail -n 40 "$LOG" 2>/dev/null
        } >"$TRIM_TEMP_LOGFILE" 2>/dev/null
    fi
    log "ERROR: $1"
    exit 1
}

pid_of() {
    [ -r "$PIDF" ] || return 1
    local p
    p=$(head -n 1 "$PIDF" 2>/dev/null | tr -d '[:space:]')
    [ -n "$p" ] || return 1
    printf '%s' "$p"
}

is_running() {
    local p
    p=$(pid_of) || return 1
    if kill -0 "$p" 2>/dev/null; then
        return 0
    fi
    rm -f "$PIDF"
    return 1
}

do_start() {
    if is_running; then
        return 0
    fi

    command -v node >/dev/null 2>&1 || fail "未找到 Node.js，请确认 nodejs_v24 依赖已安装。"
    [ -f "$SERVER" ] || fail "服务端文件缺失：$SERVER"

    mkdir -p "$VAR" 2>/dev/null
    rm -f "$SOCK" 2>/dev/null
    : >>"$LOG" 2>/dev/null

    cd "$APP" || fail "无法进入应用目录：$APP"

    if command -v setsid >/dev/null 2>&1; then
        setsid node "$SERVER" >>"$LOG" 2>&1 &
    else
        nohup node "$SERVER" >>"$LOG" 2>&1 &
    fi
    echo $! >"$PIDF"

    local i
    if [ "${ANIRSS_PORT}" != "0" ] && command -v curl >/dev/null 2>&1; then
        # fnOS 桌面入口使用独立端口，优先确认 HTTP 服务真的可访问
        for i in $(seq 1 80); do
            if curl -fsS "http://127.0.0.1:${ANIRSS_PORT}/api/health" >/dev/null 2>&1; then
                return 0
            fi
            sleep 0.25
        done
    else
        for i in $(seq 1 80); do
            [ -S "$SOCK" ] && return 0
            sleep 0.25
        done
    fi

    fail "AniRSS 追番台启动失败：服务未能在预期时间内监听端口 ${ANIRSS_PORT} 或创建 Socket。"
}

do_stop() {
    local p
    p=$(pid_of) || return 0
    if ! kill -0 "$p" 2>/dev/null; then
        rm -f "$PIDF"
        return 0
    fi

    kill -TERM "$p" 2>/dev/null
    local i=0
    while kill -0 "$p" 2>/dev/null && [ "$i" -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    if kill -0 "$p" 2>/dev/null; then
        kill -KILL "$p" 2>/dev/null
        sleep 1
    fi
    rm -f "$PIDF" "$SOCK" 2>/dev/null
    return 0
}

case "${1:-}" in
start)
    do_start
    exit 0
    ;;
stop)
    do_stop
    exit 0
    ;;
status)
    if is_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
