#!/bin/bash
# 卸载清理：默认保留数据；仅当用户在卸载向导里选择「删除」时才清理本应用目录。
set -u

APPNAME="${TRIM_APPNAME:-anirss}"
MODE="${wizard_uninstall_data_action:-keep}"
REMOVED=0
SKIPPED=0

remove_if_own() {
    local target="$1"
    local expect="$2"
    [ -n "$target" ] || return 0
    [ -e "$target" ] || return 0
    case "$target" in
        */"$expect") ;;
        *)
            echo "skip (unexpected path): $target"
            SKIPPED=$((SKIPPED + 1))
            return 0
            ;;
    esac
    case "$target" in
        "/"|"/vol"*"/@"*|"/var/apps/"*|"/usr/local/apps/@"*)
            rm -rf -- "$target" && {
                echo "removed: $target"
                REMOVED=$((REMOVED + 1))
            }
            ;;
        *)
            echo "skip (not an app-owned path): $target"
            SKIPPED=$((SKIPPED + 1))
            ;;
    esac
}

echo "uninstall data mode: $MODE"

if [ "$MODE" = "delete" ]; then
    remove_if_own "${TRIM_PKGVAR:-}" "$APPNAME"
    remove_if_own "${TRIM_PKGETC:-}" "$APPNAME"
    remove_if_own "${TRIM_PKGHOME:-}" "$APPNAME"
    remove_if_own "${TRIM_PKGMETA:-}" "$APPNAME"
    echo "deleted $REMOVED path(s), skipped $SKIPPED"
else
    echo "user data kept: ${TRIM_PKGVAR:-}"
fi

exit 0
